{
  "name": "koishi-plugin-yesimbot-image-tools",
  "version": "0.0.1",
  "description": "",
  "bugs": {
    "url": "https://github.com/YesWeAreBot/YesImBot/issues"
  },
  "license": "MIT",
  "contributors": [
    "MiaowFISH <miaowfish@qq.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YesWeAreBot/YesImBot.git",
    "directory": "plugins/image-tools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npx pkgroll --sourcemap=inline",
    "check-types": "tsc --noEmit",
    "clean": "rimraf .turbo && rimraf dist && rimraf tsconfig.tsbuildinfo",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "pub": "yarn npm publish --access public",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "ai": "^6.0.0"
  },
  "devDependencies": {
    "@yesimbot/agent-runtime": "workspace:^",
    "koishi": "^4.18.10",
    "koishi-plugin-yesimbot": "workspace:^",
    "vitest": "^4.0.18",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@yesimbot/agent-runtime": "workspace:^",
    "koishi": "^4.18.10",
    "koishi-plugin-yesimbot": "workspace:^",
    "zod": "^3.25.76"
  },
  "koishi": {
    "description": {
      "zh": "OpenAI-compatible 图片生成与编辑工具插件",
      "en": "OpenAI-compatible image generation and editing tools plugin"
    },
    "service": {
      "required": [
        "yesimbot.model"
      ]
    }
  }
}
